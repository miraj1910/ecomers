# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string (local dev)
# DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ecommers?schema=public"
#
# Supabase (production on Vercel):
#   DATABASE_URL uses the pooler (port 6543) for serverless runtime connections.
#   DIRECT_URL uses the direct connection (port 5432) for migrations/seed only.
#
# DATABASE_URL="postgresql://postgres.<project>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres"
# DIRECT_URL="postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres?connect_timeout=30"
#
# Vercel build environments may fail on IPv6-only resolution.
# If runtime connectivity issues occur, consider:
#   - Supabase pooler (port 6543) as DATABASE_URL
#   - IPv4-forced connection string (family=4 in pg.Pool config)
#   - Alternative pooler configuration
#
# ─── NextAuth / Auth.js ─────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Stripe ─────────────────────────────────────────────────
# Test keys: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook secret: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Sanity (optional — leave empty to use local MDX content) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used for SEO metadata (can be same as APP_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
