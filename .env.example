# ─── Database ───────────────────────────────────────────────
# PostgreSQL connection string
# LOCAL (non-Supabase):
#   DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/ecommers?schema=public"
#
# Supabase — TWO connection modes:
#   1) Direct (dev only):  postgresql://postgres:<password>@db.<project>.supabase.co:5432/postgres
#   2) Pooler (REQUIRED on Vercel):  postgresql://postgres.<project>:<password>@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# ⚠️  CRITICAL: URL-encode special characters in passwords!
#     Space → %20   @ → %40   # → %23   $ → %24   % → %25
#     Example: "MiRaJ GaJeRa" → "MiRaJ%20GaJeRa"
#
# ⚠️  Prisma 7 does NOT support directUrl — pooler handles both runtime & migrations.
#     If runtime connectivity fails, ensure DATABASE_URL uses the pooler.
#     Vercel build environments may fail on IPv6-only resolution with direct connections.
#
# ─── NextAuth / Auth.js ─────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Google OAuth credentials (https://console.cloud.google.com/apis/credentials)
# Set BOTH naming schemes. Auth.js v5 uses AUTH_GOOGLE_* as fallback
# when explicit clientId/clientSecret are missing.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Stripe ─────────────────────────────────────────────────
# Test keys: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# Webhook secret: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_...

# ─── Sanity (optional — leave empty to use local MDX content) ──
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# ─── Admin Authentication ──────────────────────────────────
# Generate with: node -e "console.log(require('bcryptjs').hashSync('your-password', 10))"
ADMIN_PASSWORD_HASH=

# ─── Email (Resend) ────────────────────────────────────────
# https://resend.com/api-keys
# RESEND_API_KEY=re_...
# EMAIL_FROM=orders@yourdomain.com

# ─── Cart Recovery ─────────────────────────────────────────
# Hours to wait before sending a cart recovery email (default: 24)
# CART_RECOVERY_DELAY_HOURS=24
# Secret for authenticating cron endpoint calls
# CRON_SECRET=your-cron-secret

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Used for SEO metadata (can be same as APP_URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
